<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#000000">
<androidx.camera.view.PreviewView android:id="@+id/preview" android:layout_width="match_parent" android:layout_height="match_parent" app:scaleType="fillCenter"/>
<TextView android:id="@+id/timeText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="top|center_horizontal" android:layout_marginTop="28dp" android:padding="10dp" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold" android:background="#66000000"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" android:gravity="center" android:padding="22dp">
<Button android:id="@+id/flip" android:layout_width="90dp" android:layout_height="55dp" android:text="FLIP"/>
<Space android:layout_width="35dp" android:layout_height="1dp"/>
<Button android:id="@+id/capture" android:layout_width="90dp" android:layout_height="70dp" android:text="PHOTO"/>
</LinearLayout>
</FrameLayout>
